# 관리자 로그인 비밀번호 (임의의 강한 문자열)
ADMIN_PASSWORD=

# 관리자 세션 JWT 서명 키 (32자 이상 권장, 예: openssl rand -base64 32)
ADMIN_JWT_SECRET=

# Vercel Blob 읽기/쓰기 토큰
# Vercel 대시보드에서 Blob 스토어를 프로젝트에 연결하면 자동 주입됩니다.
# 로컬 개발 시에는 Blob 스토어의 토큰을 여기에 넣으세요.
BLOB_READ_WRITE_TOKEN=

# (선택) Blob에 데이터가 없을 때 초기값을 가져올 GitHub 원본 베이스 URL
# 기본값: https://raw.githubusercontent.com/romanceformoon/toki-be/refs/heads/main/table
# TABLE_SEED_BASE_URL=
