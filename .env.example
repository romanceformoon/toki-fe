# 관리자 로그인 비밀번호 (임의의 강한 문자열)
ADMIN_PASSWORD=

# 관리자 세션 JWT 서명 키 (32자 이상 권장, 예: openssl rand -base64 32)
ADMIN_JWT_SECRET=

# Upstash Redis (테이블 JSON 저장소)
# Vercel 대시보드 > Storage 에서 Upstash Redis를 프로젝트에 연결하면 KV_REST_API_* 가 자동 주입됩니다.
# 로컬 개발 시에는 `vercel env pull` 하거나 Upstash 콘솔의 REST URL/토큰을 넣으세요.
# (Upstash 콘솔에서 직접 만든 DB라면 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 이름도 지원)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (선택) Redis에 데이터가 없을 때 초기값을 가져올 GitHub 원본 베이스 URL
# 기본값: https://raw.githubusercontent.com/romanceformoon/toki-be/refs/heads/main/table
# TABLE_SEED_BASE_URL=
